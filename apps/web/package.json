{
  "name": "@codebasecanvas/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node --experimental-strip-types e2e/verify-static-assets.ts && node --experimental-strip-types --test e2e/verify-static-assets.node.ts",
    "preview": "pnpm build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run --config vitest.config.ts",
    "deploy:check": "pnpm build && wrangler deploy --config dist/wrangler.json --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "cytoscape-fcose": "2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@playwright/test": "1.63.0",
    "@types/cytoscape-fcose": "2.2.5",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.140.0"
  }
}
